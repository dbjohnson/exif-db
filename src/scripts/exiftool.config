# Tags of our own for scan.sh, which loads this with -config
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Composite' => {
        # 1 for a screenshot from an iPhone or iPad, which iOS marks in UserComment
        Screenshot => {
            Require => 'UserComment',
            ValueConv => '$val eq "Screenshot" ? 1 : undef',
        },
    },
);
1;
